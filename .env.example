# ==============================================================================
# Binance Futures HA Trading Bot — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR TESTNET CREDENTIALS.
# NEVER COMMIT .env OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# Operational Mode (TESTNET | PRODUCTION)
# Enforced safeguard: Development and initial phases MUST use TESTNET.
APP_ENV=testnet

# Binance Futures Testnet API Credentials (get from https://testnet.binancefuture.com)
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here

# Binance Futures API Endpoints
BINANCE_REST_BASE_URL=https://testnet.binancefuture.com
BINANCE_WS_BASE_URL=wss://stream.binancefuture.com/ws

# Strategy & Timeframes
TIMEFRAME_TRIGGER=15m
TIMEFRAME_CONFIRMATION=1m

# Risk Management Parameters
NOMINAL_RISK_RATIO=0.10          # 10% of current Futures account equity per trade
REWARD_RISK_RATIO=3.0            # 3:1 gross reward-to-risk ratio
SWING_CONFIRMATION_BARS=5        # 5 bars left, 5 bars right
SWING_STOP_BUFFER_RATIO=0.001     # 0.1% buffer beyond confirmed swing high/low
ESTIMATED_TAKER_FEE_RATIO=0.0005  # 0.05% taker fee estimate for sizing
ESTIMATED_SLIPPAGE_RATIO=0.0005   # 0.05% slippage estimate for sizing

# Market Scanner Configuration
SCANNER_REFRESH_INTERVAL_SEC=60   # Refresh universe every 60 seconds
SCANNER_TOP_N=20                  # Top 20 eligible gainers
SCANNER_MIN_QUOTE_VOLUME_24H=1000000.0 # Min 24h quote volume (USDT)
SCANNER_QUOTE_ASSET=USDT
SCANNER_CONTRACT_TYPE=PERPETUAL

# Execution Safeguards
GLOBAL_MAX_POSITIONS=1            # Exactly one bot-managed position globally
DEFAULT_MARGIN_TYPE=ISOLATED      # Strictly isolated margin
USE_MAX_LEVERAGE=true             # Apply maximum permitted leverage for bracket

# Storage & Persistence
DATABASE_URL=sqlite:///data/trading_bot.db
DB_FILE_PATH=data/trading_bot.db

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=logs/trading_bot.log
LOG_ROTATION=10MB
LOG_RETENTION_DAYS=7

# Network & Resilience
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=1.5
